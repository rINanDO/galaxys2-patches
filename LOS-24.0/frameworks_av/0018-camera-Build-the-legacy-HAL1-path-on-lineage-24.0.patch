From a6c94962ec437d7668ab861435c7e87d564cb2bf Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Wed, 11 Nov 2026 15:13:51 +0100
Subject: [PATCH] camera: Build the legacy HAL1 path on lineage-24.0

Adapt the restored HALv1 code to the current camera service interfaces:
- CameraSource::CreateFromCamera and CameraClient preview/video targets
  take sp<SurfaceType> instead of sp<IGraphicBufferProducer>.
- CameraClient audio restriction uses the
  ICameraDeviceUser::AudioRestriction enum.
- logClose() takes an error state.
- HidlProviderInfo device info implements the new warmUp() (no-op).
- Drop unused locals in CameraService::connectLegacy.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I824de3387276d6944fbfac67d5aca69651899f85
---
 media/libstagefright/CameraSource.cpp         |  2 +-
 .../camera/libcameraservice/CameraService.cpp |  3 --
 .../libcameraservice/api1/CameraClient.cpp    | 32 ++++++++++---------
 .../libcameraservice/api1/CameraClient.h      | 13 ++++----
 .../common/hidl/HidlProviderInfo.h            |  2 ++
 5 files changed, 27 insertions(+), 25 deletions(-)

diff --git a/media/libstagefright/CameraSource.cpp b/media/libstagefright/CameraSource.cpp
index 56c3f9af1a..baac4a38d9 100644
--- a/media/libstagefright/CameraSource.cpp
+++ b/media/libstagefright/CameraSource.cpp
@@ -205,7 +205,7 @@ CameraSource *CameraSource::CreateFromCamera(
     pid_t clientPid,
     Size videoSize,
     int32_t frameRate,
-    const sp<IGraphicBufferProducer>& surface,
+    const sp<SurfaceType>& surface,
     bool storeMetaDataInVideoBuffers) {
 
     CameraSource *source = new CameraSource(camera, proxy, cameraId,
diff --git a/services/camera/libcameraservice/CameraService.cpp b/services/camera/libcameraservice/CameraService.cpp
index facc2fdb11..f85cb26d08 100644
--- a/services/camera/libcameraservice/CameraService.cpp
+++ b/services/camera/libcameraservice/CameraService.cpp
@@ -2358,9 +2358,6 @@ Status CameraService::connectLegacy(
     bool isNonSystemNdk = clientPackageNameMaybe.size() == 0;
     logConnectionAttempt(clientAttribution.pid, clientPackageNameMaybe, cameraIdStr, API_1);
 
-    int clientUid = clientAttribution.uid;
-    int clientPid = clientAttribution.pid;
-
     // connectLegacy retains the legacy AIDL rotationOverride int; the modern client-facing
     // API1/API2 paths use CameraCompatibilityInfo instead, so translate to a default (no
     // override) instance here since this HAL1 path doesn't consume rotate-and-crop compat.
diff --git a/services/camera/libcameraservice/api1/CameraClient.cpp b/services/camera/libcameraservice/api1/CameraClient.cpp
index a1c348eb92..4bfb976f69 100644
--- a/services/camera/libcameraservice/api1/CameraClient.cpp
+++ b/services/camera/libcameraservice/api1/CameraClient.cpp
@@ -291,7 +291,7 @@ binder::Status CameraClient::disconnect() {
 
     LOG1("disconnect X (pid %d)", callingPid);
     int32_t closeLatencyMs = ns2ms(systemTime() - startTime);
-    mCameraServiceProxyWrapper->logClose(mCameraIdStr, closeLatencyMs, false);
+    mCameraServiceProxyWrapper->logClose(mCameraIdStr, closeLatencyMs, false, 0 /*errorState*/);
     return res;
 }
 
@@ -342,14 +342,17 @@ status_t CameraClient::setPreviewWindow(const sp<IBinder>& binder,
 }
 
 // set the buffer consumer that the preview will use
-status_t CameraClient::setPreviewTarget(
-        const sp<IGraphicBufferProducer>& bufferProducer) {
-    LOG1("setPreviewTarget(%p) (pid %d)", bufferProducer.get(),
-            getCallingPid());
+status_t CameraClient::setPreviewTarget(const sp<SurfaceType>& target) {
+    LOG1("setPreviewTarget(%p) (pid %d)", target.get(), getCallingPid());
 
     sp<IBinder> binder;
     sp<ANativeWindow> window;
-    if (bufferProducer != 0) {
+    if (target != 0) {
+#if WB_LIBCAMERASERVICE_WITH_DEPENDENCIES
+        sp<IGraphicBufferProducer> bufferProducer = target->getIGraphicBufferProducer();
+#else
+        sp<IGraphicBufferProducer> bufferProducer = target;
+#endif
         binder = IInterface::asBinder(bufferProducer);
         // Using controlledByApp flag to ensure that the buffer queue remains in
         // async mode for the old camera API, where many applications depend
@@ -374,9 +377,8 @@ void CameraClient::setPreviewCallbackFlag(int callback_flag) {
     }
 }
 
-status_t CameraClient::setPreviewCallbackTarget(
-        const sp<IGraphicBufferProducer>& callbackProducer) {
-    (void)callbackProducer;
+status_t CameraClient::setPreviewCallbackTarget(const sp<SurfaceType>& target) {
+    (void)target;
     ALOGE("%s: Unimplemented!", __FUNCTION__);
     return INVALID_OPERATION;
 }
@@ -1219,15 +1221,15 @@ int CameraClient::getOrientation(int degrees, bool mirror) {
     return -1;
 }
 
-status_t CameraClient::setVideoTarget(const sp<IGraphicBufferProducer>& bufferProducer) {
-    (void)bufferProducer;
+status_t CameraClient::setVideoTarget(const sp<SurfaceType>& target) {
+    (void)target;
     ALOGE("%s: %d: CameraClient doesn't support setting a video target.", __FUNCTION__, __LINE__);
     return INVALID_OPERATION;
 }
 
-status_t CameraClient::setAudioRestriction(int mode) {
+status_t CameraClient::setAudioRestriction(hardware::camera2::ICameraDeviceUser::AudioRestriction mode) {
     if (!isValidAudioRestriction(mode)) {
-        ALOGE("%s: invalid audio restriction mode %d", __FUNCTION__, mode);
+        ALOGE("%s: invalid audio restriction mode %d", __FUNCTION__, static_cast<int32_t>(mode));
         return BAD_VALUE;
     }
 
@@ -1238,10 +1240,10 @@ status_t CameraClient::setAudioRestriction(int mode) {
     return BasicClient::setAudioRestriction(mode);
 }
 
-int32_t CameraClient::getGlobalAudioRestriction() {
+hardware::camera2::ICameraDeviceUser::AudioRestriction CameraClient::getGlobalAudioRestriction() {
     Mutex::Autolock lock(mLock);
     if (checkPidAndHardware() != NO_ERROR) {
-        return INVALID_OPERATION;
+        return hardware::camera2::ICameraDeviceUser::AudioRestriction::NONE;
     }
     return BasicClient::getServiceAudioRestriction();
 }
diff --git a/services/camera/libcameraservice/api1/CameraClient.h b/services/camera/libcameraservice/api1/CameraClient.h
