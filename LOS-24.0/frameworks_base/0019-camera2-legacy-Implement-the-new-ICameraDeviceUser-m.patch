 import android.hardware.camera2.utils.SubmitInfo;
 import android.hardware.common.fmq.MQDescriptor;
 import android.os.ConditionVariable;
@@ -658,6 +661,51 @@ public class CameraDeviceUserShim implements ICameraDeviceUser {
         }
     }
 
+    @Override
+    public OutputAndInputStreamIds configureStreams(SessionConfigurationAndStreamIds config) {
+        if (DEBUG) {
+            Log.d(TAG, "configureStreams called.");
+        }
+        SessionConfiguration session = config.sessionConfigurationDelta;
+        OutputAndInputStreamIds result = new OutputAndInputStreamIds();
+        result.inputStreamId = -1;
+
+        // CameraDeviceImpl only uses this batched call when configure_streams_batch is enabled,
+        // so run the same begin/delete/create/end sequence as the non-batched path.
+        beginConfigure();
+        try {
+            if (config.deletedStreamIds != null) {
+                for (int streamId : config.deletedStreamIds) {
+                    deleteStream(streamId);
+                }
+            }
+
+            InputConfiguration input = session.getInputConfiguration();
+            if (input != null) {
+                result.inputStreamId = createInputStream(input.getWidth(), input.getHeight(),
+                        input.getFormat(), input.isMultiResolution());
+            }
+
+            List<OutputConfiguration> outputs = session.getOutputConfigurations();
+            result.outputStreamIds = new int[outputs.size()];
+            for (int i = 0; i < result.outputStreamIds.length; i++) {
+                result.outputStreamIds[i] = createStream(outputs.get(i));
+            }
+        } catch (RuntimeException e) {
+            // Don't leave a failed configuration in progress, or every retry would be rejected.
+            synchronized (mConfigureLock) {
+                mConfiguring = false;
+            }
+            throw e;
+        }
+
+        CaptureRequest sessionParams = session.getSessionParameters();
+        result.offlineStreamIds = endConfigure(session.getSessionType(),
+                sessionParams != null ? sessionParams.getNativeCopy() : null,
+                config.createSessionTime);
+        return result;
+    }
+
     @Override
     public void finalizeOutputConfigurations(int steamId, OutputConfiguration config) {
         String err = "Finalizing output configuration is not supported on legacy devices";
@@ -718,6 +766,11 @@ public class CameraDeviceUserShim implements ICameraDeviceUser {
         // TODO: b/63912484 implement updateOutputConfiguration.
     }
 
+    @Override
+    public void updateOutputConfigurations(int[] streamIds, OutputConfiguration[] configs) {
+        // Not supported by the legacy shim, same as updateOutputConfiguration.
+    }
+
     @Override
