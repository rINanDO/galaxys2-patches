 import java.nio.FloatBuffer;
+import java.time.Duration;
+import java.util.concurrent.Executor;
 
 /**
  * <p>
@@ -79,6 +83,7 @@ final class ColorFade {
     // be ready to run smoothly.  We use 3 frames because we are triple-buffered.
     // See code for details.
     private static final int DEJANK_FRAMES = 3;
+    private static final int PRESENT_FENCE_TIMEOUT_MILLIS = 500;
 
     private static final int EGL_GL_COLORSPACE_KHR = 0x309D;
     private static final int EGL_GL_COLORSPACE_DISPLAY_P3_PASSTHROUGH_EXT = 0x3490;
@@ -96,6 +101,9 @@ final class ColorFade {
     private int mDisplayWidth;      // real width, not rotated
     private int mDisplayHeight;     // real height, not rotated
     private SurfaceControl mSurfaceControl;
+    // Called once the next surface change is on the display.
+    private Executor mFrameExecutor;
+    private Runnable mFrameCallback;
     private Surface mSurface;
     private SurfaceControl mBLASTSurfaceControl;
     private BLASTBufferQueue mBLASTBufferQueue;
@@ -795,12 +803,43 @@ final class ColorFade {
         }
     }
 
+    /**
+     * Runs the callback once the next change to the color fade surface is on the display.
+     * Returns false if there is no surface.
+     */
+    public boolean runAfterNextFrame(Executor executor, Runnable callback) {
+        if (mSurfaceControl == null) {
+            return false;
+        }
+        mFrameExecutor = executor;
+        mFrameCallback = callback;
+        return true;
+    }
+
     private boolean showSurface(float alpha) {
         if (!mSurfaceVisible || mSurfaceAlpha != alpha) {
             mTransaction.setLayer(mSurfaceControl, COLOR_FADE_LAYER)
                     .setAlpha(mSurfaceControl, alpha)
-                    .show(mSurfaceControl)
-                    .apply();
+                    .show(mSurfaceControl);
+            if (mFrameCallback != null) {
+                final Runnable callback = mFrameCallback;
+                final Executor executor = mFrameExecutor;
+                // The transaction completes once SurfaceFlinger has composited it, but the
+                // GPU may still be busy with the composition: wait for the present fence,
+                // which signals once the frame is actually on the display.
+                mTransaction.addTransactionCompletedListener(BackgroundThread.getExecutor(),
+                        stats -> {
+                            try (SyncFence fence = stats.getPresentFence()) {
+                                if (fence.isValid()) {
+                                    fence.await(Duration.ofMillis(PRESENT_FENCE_TIMEOUT_MILLIS));
+                                }
+                            }
+                            executor.execute(callback);
+                        });
+                mFrameCallback = null;
+                mFrameExecutor = null;
+            }
+            mTransaction.apply();
             mSurfaceVisible = true;
             mSurfaceAlpha = alpha;
         }
