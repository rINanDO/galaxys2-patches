+    // The screen on fade takes this many steps. Each one waits until the previous one is on
+    // the display and has been shown for the minimum time, or until the timeout.
+    private static final int COLOR_FADE_ON_STEPS = 8;
+    private static final int COLOR_FADE_ON_STEP_MIN_MILLIS = 40;
+    private static final int COLOR_FADE_ON_STEP_TIMEOUT_MILLIS = 600;
 
     private static final int MSG_UPDATE_POWER_STATE = 1;
     private static final int MSG_SCREEN_ON_UNBLOCKED = 2;
@@ -442,6 +447,8 @@ final class DisplayPowerController implements AutomaticBrightnessController.Call
 
     // Animators.
     private ObjectAnimator mColorFadeOffAnimator;
+    // The step of the screen on fade, or -1 if it isn't running.
+    private int mColorFadeOnStep = -1;
     private DualRampAnimator<DisplayPowerState> mScreenBrightnessRampAnimator;
 
     // True if this DisplayPowerController has been stopped and should no longer be running.
@@ -2219,6 +2226,10 @@ final class DisplayPowerController implements AutomaticBrightnessController.Call
 
     private void animateScreenStateChange(
             int target, @Display.StateReason int reason, boolean performScreenOffTransition) {
+        if (target != Display.STATE_ON) {
+            mColorFadeOnStep = -1;
+        }
+
         // If there is already an animation in progress, don't interfere with it.
         if (mColorFadeEnabled && mColorFadeOffAnimator.isStarted()) {
             if (target != Display.STATE_ON) {
@@ -2272,6 +2283,24 @@ final class DisplayPowerController implements AutomaticBrightnessController.Call
             if (!setScreenState(Display.STATE_ON, reason)) {
                 return; // screen on blocked
             }
+            // The content is drawn: fade the black layer out. A timed animation loses most
+            // of its frames here, since the display pipeline stalls for 100-300 ms at a
+            // time after the panel turns on, so step the fade frame by frame instead.
+            if (mColorFadeEnabled && mColorFadeFadesConfig
+                    && mPowerState.isColorFadePrepared()
+                    && mPowerState.getColorFadeLevel() < 1.0f) {
+                if (mColorFadeOnStep < 0) {
+                    if (!mPowerState.waitUntilClean(mCleanListener)) {
+                        return; // display still turning on
+                    }
+                    mColorFadeOnStep = 0;
+                    advanceColorFadeOn(0);
+                }
+                if (mColorFadeOnStep < COLOR_FADE_ON_STEPS) {
+                    return;
+                }
+            }
+            mColorFadeOnStep = -1;
             mPowerState.setColorFadeLevel(1.0f);
             mPowerState.dismissColorFade();
         } else if (target == Display.STATE_DOZE) {
@@ -2364,6 +2393,32 @@ final class DisplayPowerController implements AutomaticBrightnessController.Call
 
     private final Runnable mCleanListener = this::sendUpdatePowerState;
 
+    private void advanceColorFadeOn(int fromStep) {
+        if (mColorFadeOnStep != fromStep) {
+            return; // the screen state changed, or the other trigger already advanced
+        }
+        final int step = fromStep + 1;
+        mColorFadeOnStep = step;
+        if (step >= COLOR_FADE_ON_STEPS) {
+            sendUpdatePowerState();
+            return;
+        }
+        // Advance once the step is on the display, but not faster than the minimum step
+        // time: at full frame rate the fade would otherwise be over too quickly to see.
+        final long stepTime = SystemClock.uptimeMillis();
+        mPowerState.runAfterNextColorFadeFrame(mHandler::post, () -> {
+            final long remaining = stepTime + COLOR_FADE_ON_STEP_MIN_MILLIS
+                    - SystemClock.uptimeMillis();
+            if (remaining > 0) {
+                mHandler.postDelayed(() -> advanceColorFadeOn(step), remaining);
+            } else {
+                advanceColorFadeOn(step);
+            }
+        });
+        mHandler.postDelayed(() -> advanceColorFadeOn(step), COLOR_FADE_ON_STEP_TIMEOUT_MILLIS);
+        mPowerState.setColorFadeLevel((float) step / COLOR_FADE_ON_STEPS);
+    }
+
     private void sendOnStateChangedWithWakelock() {
         boolean wakeLockAcquired = mWakelockController.acquireWakelock(
                 WakelockController.WAKE_LOCK_STATE_CHANGED);
@@ -2650,6 +2705,7 @@ final class DisplayPowerController implements AutomaticBrightnessController.Call
             pw.println("  mColorFadeOffAnimator.isStarted()="
                     + mColorFadeOffAnimator.isStarted());
         }
+        pw.println("  mColorFadeOnStep=" + mColorFadeOnStep);
 
         pw.println();
         if (mPowerState != null) {
