+    /**
+     * Finishes booting behind the boot animation, so that BOOT_COMPLETED and the app startup it
+     * causes are over before the user gets the phone.
+     */
+    private void waitForBootToSettle() {
+        // The screen timeout starts when boot completes. Don't let it run out under the animation.
+        final PowerManager.WakeLock wakeLock = mPowerManager.newWakeLock(
+                PowerManager.SCREEN_BRIGHT_WAKE_LOCK | PowerManager.ON_AFTER_RELEASE,
+                "WindowManager:BootSettle");
+        wakeLock.acquire();
+        final long start = SystemClock.elapsedRealtime();
+        // finishBooting() runs on the calling thread and its services need a Looper.
+        mH.post(() -> {
+            try {
+                mActivityManager.bootAnimationComplete();
+            } catch (RemoteException e) {
+            }
+        });
+
+        long[] last = readCpuTimes();
+        int idleSamples = 0;
+        while (last != null && idleSamples < BOOT_SETTLE_IDLE_SAMPLES
+                && SystemClock.elapsedRealtime() - start < BOOT_SETTLE_MAX_WAIT_MS) {
+            SystemClock.sleep(BOOT_SETTLE_SAMPLE_MS);
+            final long[] current = readCpuTimes();
+            if (current == null) {
+                break;
+            }
+            final long total = current[0] - last[0];
+            final long idle = current[1] - last[1];
+            final long busyPercent = total > 0 ? 100 * (total - idle) / total : 100;
+            idleSamples = busyPercent < BOOT_SETTLE_BUSY_PERCENT ? idleSamples + 1 : 0;
+            Slog.i(TAG_WM, "Boot settle: cpu busy " + busyPercent + "%");
+            last = current;
+        }
+        Slog.i(TAG_WM, "Boot settled after " + (SystemClock.elapsedRealtime() - start) + " ms");
+
+        synchronized (mGlobalLock) {
+            mBootSettled = true;
+        }
+        performEnableScreen();
+        wakeLock.release();
+    }
+
+    /** Returns the total and idle jiffies of all CPUs, or null if they can't be read. */
+    private static long[] readCpuTimes() {
+        try (BufferedReader reader = new BufferedReader(new FileReader("/proc/stat"))) {
+            final String[] fields = reader.readLine().trim().split("\\s+");
+            long total = 0;
+            for (int i = 1; i < fields.length; i++) {
+                total += Long.parseLong(fields[i]);
+            }
+            return new long[] {total, Long.parseLong(fields[4]) + Long.parseLong(fields[5])};
+        } catch (IOException | RuntimeException e) {
+            Slog.w(TAG_WM, "Can't read CPU times", e);
+            return null;
+        }
+    }
+
