From 0628eb655a7bdf6a6366e668289144db74d6b4e6 Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Wed, 25 Nov 2026 11:55:20 +0100
Subject: [PATCH] ActivityManager: Keep extending the start timeout of a
 starved process

When a process hasn't finished starting after the start timeout, the
timeout is extended once by the time the process waited for a CPU. On
the first boot com.android.phone was still starved when that extension
ran out: it had run for 7.5 s and waited 29 s for a CPU, was about 5 s
from the end of Application.onCreate(), and was declared not
responding 52 s after it started.

When an extension runs out, extend again by the time the process waited
for a CPU since the last extension, up to twice the timeout in total.
A process that is stuck doesn't wait for a CPU, so it still gets no
extension.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G5iyKS6HLKv7fpZZf1pvxH
Change-Id: Ie8332503c82fd43249d65eca5ff6c9e04553e6d0
---
 .../server/am/ActivityManagerService.java     | 21 ++++++++++++-------
 1 file changed, 14 insertions(+), 7 deletions(-)

diff --git a/services/core/java/com/android/server/am/ActivityManagerService.java b/services/core/java/com/android/server/am/ActivityManagerService.java
index b2eb3e7fea79..c24fb0b0addb 100644
--- a/services/core/java/com/android/server/am/ActivityManagerService.java
+++ b/services/core/java/com/android/server/am/ActivityManagerService.java
@@ -2108,7 +2108,7 @@ public class ActivityManagerService extends IActivityManager.Stub
                     mAppProfiler.mCachedAppsWatermarkData.updateCachedAppsSnapshot((long) msg.obj);
                 } break;
                 case BIND_APPLICATION_TIMEOUT_SOFT_MSG: {
-                    handleBindApplicationTimeoutSoft((ProcessRecord) msg.obj, msg.arg1);
+                    handleBindApplicationTimeoutSoft((ProcessRecord) msg.obj, msg.arg1, msg.arg2);
                 } break;
                 case BIND_APPLICATION_TIMEOUT_HARD_MSG: {
                     handleBindApplicationTimeoutHard((ProcessRecord) msg.obj);
@@ -5763,13 +5763,19 @@ public class ActivityManagerService extends IActivityManager.Stub
         }
     }
 
-    private void handleBindApplicationTimeoutSoft(ProcessRecord app, int softTimeoutMillis) {
+    private void handleBindApplicationTimeoutSoft(ProcessRecord app, int softTimeoutMillis,
+            int extendedMillis) {
         // Similar logic as the broadcast delivery timeout:
         // instead of immediately triggering an ANR, extend the timeout by
-        // the amount of time the process was runnable-but-waiting; we're
-        // only willing to do this once before triggering an hard ANR.
-        final long cpuDelayTime = app.getCpuDelayTime() - app.mProfile.mLastCpuDelayTime.get();
-        final long hardTimeoutMillis = MathUtils.constrain(cpuDelayTime, 0, softTimeoutMillis);
+        // the amount of time the process was runnable-but-waiting.
+        // A process that is still starved after an extension, as on the first
+        // boot of a slow device, has waited for the CPU again during it, so
+        // extend once more by that time, up to twice the timeout in total.
+        // A process that is stuck doesn't wait for the CPU and gets no more time.
+        final long cpuDelayTime = app.getCpuDelayTime() - app.mProfile.mLastCpuDelayTime.get()
+                - extendedMillis;
+        final long hardTimeoutMillis = MathUtils.constrain(cpuDelayTime, 0,
+                Math.min(softTimeoutMillis, 2L * softTimeoutMillis - extendedMillis));
 
         if (hardTimeoutMillis == 0) {
             handleBindApplicationTimeoutHard(app);
@@ -5779,7 +5785,8 @@ public class ActivityManagerService extends IActivityManager.Stub
         Slog.i(TAG, "Extending process start timeout by " + hardTimeoutMillis + "ms for " + app);
         Trace.instant(Trace.TRACE_TAG_ACTIVITY_MANAGER, "bindApplicationTimeSoft "
                 + app.processName + "(" + app.getPid() + ")");
-        final Message msg = mHandler.obtainMessage(BIND_APPLICATION_TIMEOUT_HARD_MSG, app);
+        final Message msg = mHandler.obtainMessage(BIND_APPLICATION_TIMEOUT_SOFT_MSG,
+                softTimeoutMillis, extendedMillis + (int) hardTimeoutMillis, app);
         mHandler.sendMessageDelayed(msg, hardTimeoutMillis);
     }
 
