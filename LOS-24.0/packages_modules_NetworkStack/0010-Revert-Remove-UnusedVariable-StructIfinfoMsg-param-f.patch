From 10446e4da16cd8858447d9589976f07e371dc25a Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Sun, 21 Sep 2025 09:47:11 -0400
Subject: [PATCH 10/17] Revert "Remove UnusedVariable StructIfinfoMsg param
 from updateClatInterfaceLinkState."

This reverts commit dfc02315da2ef6b3f8575197c3e7efe59544cc12.

Change-Id: I3bde186f3027fe5ec6e5a8b374407d771e15ba25
---
 src/android/net/ip/IpClientLinkObserver.java | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/android/net/ip/IpClientLinkObserver.java b/src/android/net/ip/IpClientLinkObserver.java
index ff7b8f457..6fff3ee49 100644
--- a/src/android/net/ip/IpClientLinkObserver.java
+++ b/src/android/net/ip/IpClientLinkObserver.java
@@ -549,7 +549,8 @@ public class IpClientLinkObserver {
         }
     }
 
-    private void updateClatInterfaceLinkState(@Nullable final String ifname, short nlMsgType) {
+    private void updateClatInterfaceLinkState(@NonNull final StructIfinfoMsg ifinfoMsg,
+            @Nullable final String ifname, short nlMsgType) {
         switch (nlMsgType) {
             case NetlinkConstants.RTM_NEWLINK:
                 mCallback.onClatInterfaceStateUpdate(true /* add interface */);
@@ -590,7 +591,7 @@ public class IpClientLinkObserver {
         final short nlMsgType = msg.getHeader().nlmsg_type;
         final StructIfinfoMsg ifinfoMsg = msg.getIfinfoHeader();
         if (mClatInterfaceName.equals(ifname)) {
-            updateClatInterfaceLinkState(ifname, nlMsgType);
+            updateClatInterfaceLinkState(ifinfoMsg, ifname, nlMsgType);
             return;
         }
 
