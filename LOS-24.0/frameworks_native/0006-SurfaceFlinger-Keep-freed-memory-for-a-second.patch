From b87678be430ded2b9c8979078c0d5eb5012ffd3a Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Tue, 17 Nov 2026 22:37:11 +0100
Subject: [PATCH] SurfaceFlinger: Keep freed memory for a second

Native processes run with the allocator's default decay time of 0, so
every free() of a page-sized buffer goes back to the kernel at once and
the next malloc() maps, names and zeroes a fresh page. SurfaceFlinger's
main thread did that about 90 times a second during video playback
(mmap + prctl + munmap per page). Use a decay time of one second, as
the Zygote sets for apps.

On an Exynos 4210 at 800 MHz playing a 480p video, the main thread's
CPU time drops from about 22% to 18% of one core.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01G5iyKS6HLKv7fpZZf1pvxH
Change-Id: I5726d4f384a5869a06379e13efe734ba2a94cbab
---
 services/surfaceflinger/main_surfaceflinger.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/services/surfaceflinger/main_surfaceflinger.cpp b/services/surfaceflinger/main_surfaceflinger.cpp
index 0c649c5bc5..a63ad8950b 100644
--- a/services/surfaceflinger/main_surfaceflinger.cpp
+++ b/services/surfaceflinger/main_surfaceflinger.cpp
@@ -29,6 +29,7 @@
 #include <binder/ProcessState.h>
 #include <common/FlagManager.h>
 #include <errno.h>
+#include <malloc.h>
 #include <hidl/LegacySupport.h>
 #include <processgroup/sched_policy.h>
 #include "SurfaceFlinger.h"
@@ -81,6 +82,12 @@ static void startDisplayService() {
 int main() {
     signal(SIGPIPE, SIG_IGN);
 
+    // Composition allocates and frees page-sized buffers on every frame.
+    // With the native default decay time of 0, each free() goes back to
+    // the kernel at once and the next malloc() maps and zeroes a fresh
+    // page. Keep freed memory for a second, as apps do.
+    mallopt(M_DECAY_TIME, 1);
+
     hardware::configureRpcThreadpool(1 /* maxThreads */,
             false /* callerWillJoin */);
 
