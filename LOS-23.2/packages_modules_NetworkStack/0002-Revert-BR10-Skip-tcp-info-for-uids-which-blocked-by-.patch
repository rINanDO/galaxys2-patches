+                    // TODO: Supports networking blocked by data saver.
+                    final boolean uidBlocked = mCm.isUidNetworkingBlocked(newInfo.uid,
+                            false /* isNetworkMetered */);
                     if (uidBlocked) {
                         skippedBlockedUids.add(newInfo.uid);
                         continue;
