From dfb55e061fb4a478b0fc39458d8e6cefa387cff1 Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Thu, 12 Nov 2026 22:20:56 +0100
Subject: [PATCH 2/2] libril: Link the Samsung libril against IRadio 1.2 to 1.4

The Samsung libril serves IRadio 1.4, which Android 16 requires.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I6786dbd1016ddb452f07b11835a7178f340aba33
---
 libril/Android.bp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/libril/Android.bp b/libril/Android.bp
index b46eb6a..a9ffcea 100644
--- a/libril/Android.bp
+++ b/libril/Android.bp
@@ -53,7 +53,12 @@ cc_library_shared {
         "librilutils",
         "libutils",
     ] + select(soong_config_variable("ril", "samsung_libril"), {
-        "true": ["android.hardware.radio.deprecated@1.0"],
+        "true": [
+            "android.hardware.radio.deprecated@1.0",
+            "android.hardware.radio@1.2",
+            "android.hardware.radio@1.3",
+            "android.hardware.radio@1.4",
+        ],
         default: [],
     }),
     static_libs: ["libprotobuf-c-nano-enable_malloc-32bit"],
-- 
2.54.0

