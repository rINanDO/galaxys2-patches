From 5d88d4576bff87e67e5d3e6827bac5af5353fbd7 Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Sun, 28 Nov 2021 17:28:48 +0100
Subject: [PATCH 11/12] StorageManagerService: Storage.xml: Bring back
 XML-format UTF-8

This fixes TWRP boot issues because it expectes an XML UTF-8 formatted
storage.xml file. But in Android S this is changed to
TypedXML(Serializer).

[Ported to LineageOS 23.2: only write storage.xml with the text
serializer. The reader detects the format, so it can still read a
binary file.]

Change-Id: Ic097fb234f707279e575e4c001fc8376f47cf72b
Signed-off-by: Dominggoes Isakh <drjisakh@gmail.com>
---
 .../core/java/com/android/server/StorageManagerService.java   | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/StorageManagerService.java b/services/core/java/com/android/server/StorageManagerService.java
index 81e70659f0c6..a2e49d3f8847 100644
--- a/services/core/java/com/android/server/StorageManagerService.java
+++ b/services/core/java/com/android/server/StorageManagerService.java
@@ -183,6 +183,7 @@ import java.io.IOException;
 import java.io.ObjectInputStream;
 import java.io.ObjectOutputStream;
 import java.io.PrintWriter;
+import java.nio.charset.StandardCharsets;
 import java.util.ArrayList;
 import java.util.Arrays;
 import java.util.HashMap;
@@ -2294,7 +2295,8 @@ class StorageManagerService extends IStorageManager.Stub
         try {
             fos = mSettingsFile.startWrite();
 
-            TypedXmlSerializer out = Xml.resolveSerializer(fos);
+            TypedXmlSerializer out = Xml.newFastSerializer();
+            out.setOutput(fos, StandardCharsets.UTF_8.name());
             out.startDocument(null, true);
             out.startTag(null, TAG_VOLUMES);
             out.attributeInt(null, ATTR_VERSION, VERSION_FIX_PRIMARY);
