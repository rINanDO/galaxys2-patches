From 19443c67a1a0b74cf6ecca87017a46ade2c102b0 Mon Sep 17 00:00:00 2001
From: Dominggoes Isakh <drjisakh@gmail.com>
Date: Tue, 10 Nov 2026 21:16:36 +0100
Subject: [PATCH] libprocessgroup: Use the memcg group when cgroup v2 isn't
 mounted

cgroups.json lists cgroup2 at /sys/fs/cgroup, but kernels older than
4.5 can't mount it. createProcessGroup() then fails to create the v2
group (logging two errors for every process start), and
KillProcessGroup() reads a cgroup.procs file that doesn't exist, decides
the group is empty and kills nothing.

When init restarted zygote after a surfaceflinger crash, zygote
survived, init waited for it forever in "stopping" and the screen
stayed black.

Without a mounted v2 hierarchy, skip creating the v2 group and find and
kill the processes in the per-app memcg group instead. If that isn't
available either, kill the process group of the initial pid.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I3ed4307109dab336c5f445a218672d61a51d13af
---
 libprocessgroup/processgroup.cpp | 35 ++++++++++++++++++++++++++++----
 1 file changed, 31 insertions(+), 4 deletions(-)

diff --git a/libprocessgroup/processgroup.cpp b/libprocessgroup/processgroup.cpp
index 267e62c67..9529249b0 100644
--- a/libprocessgroup/processgroup.cpp
+++ b/libprocessgroup/processgroup.cpp
@@ -418,7 +418,27 @@ static int DoKillProcessGroupOnce(const char* cgroup, uid_t uid, int initialPid,
 static int KillProcessGroup(uid_t uid, int initialPid, int signal, int retries,
                             int* max_processes) {
     std::string hierarchy_root_path;
-    CgroupGetControllerPath(CGROUPV2_CONTROLLER_NAME, &hierarchy_root_path);
+    bool use_memcg_apps = false;
+    if (!CgroupGetControllerPath(CGROUPV2_CONTROLLER_NAME, &hierarchy_root_path) ||
+        access((hierarchy_root_path + PROCESSGROUP_CGROUP_PROCS_FILE).c_str(), F_OK) != 0) {
+        // cgroup v2 isn't mounted (kernels older than 4.5 don't have it, but
+        // cgroups.json still lists it), so the process is only in its
+        // per-app memcg group (see createProcessGroup). Look for its
+        // processes there; otherwise its cgroup.procs file doesn't exist,
+        // the group looks empty and nothing is killed.
+        hierarchy_root_path.clear();
+        if (isMemoryCgroupSupported() && UsePerAppMemcg() &&
+            CgroupGetMemcgAppsPath(&hierarchy_root_path)) {
+            use_memcg_apps = true;
+        } else {
+            LOG(WARNING) << "No process cgroup for uid " << uid << " pid " << initialPid
+                         << ", only killing its process group";
+            if (kill(-initialPid, signal) == -1 && errno != ESRCH) {
+                PLOG(WARNING) << "kill(" << -initialPid << ", " << signal << ") failed";
+            }
+            return 0;
+        }
+    }
     const char* cgroup = hierarchy_root_path.c_str();
 
     std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
@@ -463,9 +483,12 @@ static int KillProcessGroup(uid_t uid, int initialPid, int signal, int retries,
                       << " in " << static_cast<int>(ms) << "ms";
         }
 
-        int err = RemoveProcessGroup(cgroup, uid, initialPid, retries);
+        // In the memcg group the processes are gone once cgroup.procs is
+        // empty, so EBUSY means the kernel couldn't move the group's memory
+        // charges. Retrying won't help; empty groups are removed later.
+        int err = RemoveProcessGroup(cgroup, uid, initialPid, use_memcg_apps ? 1 : retries);
 
-        if (isMemoryCgroupSupported() && UsePerAppMemcg()) {
+        if (!use_memcg_apps && isMemoryCgroupSupported() && UsePerAppMemcg()) {
             std::string memcg_apps_path;
             if (CgroupGetMemcgAppsPath(&memcg_apps_path) &&
                 RemoveProcessGroup(memcg_apps_path.c_str(), uid, initialPid, retries) < 0) {
@@ -558,7 +581,11 @@ int createProcessGroup(uid_t uid, int initialPid, bool memControl) {
         }
     }
 
-    CgroupGetControllerPath(CGROUPV2_CONTROLLER_NAME, &cgroup);
+    if (!CgroupGetControllerPath(CGROUPV2_CONTROLLER_NAME, &cgroup) ||
+        access((cgroup + PROCESSGROUP_CGROUP_PROCS_FILE).c_str(), F_OK) != 0) {
+        // No cgroup v2 on this kernel: the memcg group above is the only one.
+        return 0;
+    }
     return createProcessGroupInternal(uid, initialPid, cgroup, true);
 }
 
-- 
2.37.2

