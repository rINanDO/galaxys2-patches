+        private const val BRIDGE_NAME = "JellyDownloads"
+        private const val RECORD_TTL_MS = 60_000L
+        private const val MAX_BLOB_BYTES = 64L * 1024 * 1024
+
+        private fun stripFragment(url: String) = url.substringBefore('#')
+
+        private fun origin(url: String?): String? {
+            val uri = runCatching { Uri.parse(url) }.getOrNull() ?: return null
+            val scheme = uri.scheme?.lowercase() ?: return null
+            val host = uri.host?.lowercase() ?: return null
+            val port = if (uri.port != -1) uri.port else when (scheme) {
+                "http" -> 80
+                "https" -> 443
+                else -> -1
+            }
+            return "$scheme://$host:$port"
+        }
+
+        private fun encodeForm(
+            enctype: String, pairs: List<Pair<String, String>>
+        ): Pair<String, ByteArray> = when (enctype) {
+            "multipart/form-data" -> {
+                val boundary = "----JellyFormBoundary" + System.nanoTime()
+                val sb = StringBuilder()
+                for ((k, v) in pairs) {
+                    sb.append("--").append(boundary).append("\r\n")
+                    sb.append("Content-Disposition: form-data; name=\"")
+                        .append(k.replace("\"", "%22").replace("\r", "%0D").replace("\n", "%0A"))
+                        .append("\"\r\n\r\n")
+                    sb.append(v).append("\r\n")
+                }
