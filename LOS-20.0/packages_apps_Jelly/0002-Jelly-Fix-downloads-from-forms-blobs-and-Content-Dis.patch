+            userAgent?.let { conn.setRequestProperty("User-Agent", it) }
+            post.pageUrl?.let { page ->
+                conn.setRequestProperty("Referer", page)
+                origin(page)?.let { o ->
+                    conn.setRequestProperty("Origin", o.replace(Regex(":(80|443)$"), ""))
+                }
+            }
+            if (post.sameOrigin) {
+                CookieManager.getInstance().getCookie(post.url)?.takeUnless { it.isEmpty() }
+                    ?.let { conn.setRequestProperty("Cookie", it) }
+            }
+            conn.setFixedLengthStreamingMode(post.body.size)
+            conn.outputStream.use { it.write(post.body) }
+            if (conn.responseCode !in 200..299) {
+                val code = conn.responseCode
+                conn.disconnect()
+                throw IOException("HTTP $code")
+            }
+            return conn
+        }
+
+        /**
+         * Store a file in the public Downloads folder. Returns its content
+         * URI, or null when it failed.
+         */
+        fun saveToDownloads(
+            context: Context, fileName: String, mimeType: String?,
+            write: (OutputStream) -> Unit
+        ): Uri? {
+            val type = mimeType?.takeUnless { it == "application/octet-stream" }
+                ?: MimeTypeMap.getSingleton().getMimeTypeFromExtension(
+                    fileName.substringAfterLast('.', "").lowercase()
+                ) ?: "application/octet-stream"
+            return try {
+                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+                    val resolver = context.contentResolver
+                    val values = ContentValues().apply {
+                        put(MediaStore.Downloads.DISPLAY_NAME, fileName)
+                        put(MediaStore.Downloads.MIME_TYPE, type)
+                        put(MediaStore.Downloads.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS)
+                        put(MediaStore.Downloads.IS_PENDING, 1)
+                    }
+                    val uri = resolver.insert(
+                        MediaStore.Downloads.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY),
+                        values
+                    ) ?: return null
+                    try {
+                        resolver.openOutputStream(uri)!!.use(write)
+                    } catch (e: Exception) {
+                        resolver.delete(uri, null, null)
+                        throw e
+                    }
+                    resolver.update(uri, ContentValues().apply {
+                        put(MediaStore.Downloads.IS_PENDING, 0)
+                    }, null, null)
+                    uri
+                } else {
+                    val dir = context.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS)
+                        ?: return null
+                    val file = File(dir, fileName)
+                    FileOutputStream(file).use(write)
+                    Uri.fromFile(file)
+                }
+            } catch (e: Exception) {
+                Log.e(TAG, "Couldn't save $fileName", e)
+                null
+            }
+        }
+
+        fun copy(input: InputStream, output: OutputStream) {
+            input.copyTo(output, 64 * 1024)
+        }
+    }
+}
