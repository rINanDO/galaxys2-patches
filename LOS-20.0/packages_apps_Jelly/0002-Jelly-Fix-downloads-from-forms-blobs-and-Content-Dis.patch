+        fun openPost(post: RecordedPost, userAgent: String?): HttpURLConnection {
+            val conn = URL(post.url).openConnection() as HttpURLConnection
+            conn.requestMethod = "POST"
+            conn.doOutput = true
+            conn.instanceFollowRedirects = true
+            conn.connectTimeout = 30_000
+            conn.readTimeout = 60_000
