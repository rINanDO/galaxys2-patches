+package org.lineageos.jelly.webview
+
+import android.content.ContentValues
+import android.content.Context
+import android.net.Uri
+import android.os.Build
+import android.os.Environment
+import android.os.Handler
+import android.os.Looper
+import android.provider.MediaStore
+import android.util.Base64
+import android.util.Log
+import android.webkit.CookieManager
+import android.webkit.JavascriptInterface
+import android.webkit.MimeTypeMap
+import android.webkit.WebView
+import org.json.JSONArray
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.io.InputStream
+import java.io.OutputStream
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLDecoder
+import java.net.URLEncoder
+import java.security.SecureRandom
+
+/**
+ * Downloads that DownloadManager can't do by itself: the response to a form
+ * POST (DownloadManager would fetch the URL again with GET), and blob: and
+ * data: URLs. A script injected into each page records POST form submissions
+ * and the names in <a download="...">, and reads blobs for us; it talks to
+ * this class through a JavaScript interface that only accepts calls carrying
+ * a secret the injected script got, so other frames and scripts that don't
+ * know it can't feed it data.
+ */
+class DownloadHelper(private val webView: WebView) {
+    class RecordedPost(
+        val url: String,
+        val pageUrl: String?,
+        val contentType: String,
+        val body: ByteArray,
+        val sameOrigin: Boolean,
+        val time: Long,
+    )
+
+    private val secret = ByteArray(16).also { SecureRandom().nextBytes(it) }
+        .joinToString("") { "%02x".format(it) }
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    private var lastPost: RecordedPost? = null
+    private val names = LinkedHashMap<String, Pair<String, Long>>()
+    private val blobCallbacks = mutableMapOf<String, (ByteArray?, String?) -> Unit>()
+    private var nextToken = 0
+
+    // Main frame URL, kept up to date from the main thread: the JavaScript
+    // interface is called on a background thread where WebView can't be used.
+    @Volatile
+    var pageUrl: String? = null
+
+    fun install() {
+        webView.addJavascriptInterface(Bridge(), BRIDGE_NAME)
+    }
+
+    /** Run the page script; called when a page starts and when it finishes. */
+    fun inject(view: WebView, url: String?) {
+        pageUrl = url
+        view.evaluateJavascript(script(), null)
+    }
+
+    /** The POST that produced a download of [url], if one was submitted just before. */
+    fun takePost(url: String?): RecordedPost? {
+        val post = lastPost ?: return null
+        if (url == null || stripFragment(post.url) != stripFragment(url) ||
+            System.currentTimeMillis() - post.time > RECORD_TTL_MS
+        ) {
+            return null
+        }
+        lastPost = null
+        return post
+    }
+
+    /** The download attribute of the link that started a download of [url]. */
+    fun nameFor(url: String?): String? {
+        val (name, time) = names[url ?: return null] ?: return null
+        return name.takeIf { System.currentTimeMillis() - time <= RECORD_TTL_MS }
+    }
+
+    /** Read a blob: URL through the page that created it. */
+    fun readBlob(url: String, callback: (ByteArray?, String?) -> Unit) {
+        val token = (nextToken++).toString()
+        blobCallbacks[token] = callback
+        val js = "window.__jellyDl && window.__jellyDl.readBlob(" +
+                JSONArray(listOf(url, token)).toString().removeSurrounding("[", "]") + ")"
+        webView.evaluateJavascript(js) { result ->
+            if (result != "true") {
+                blobCallbacks.remove(token)?.invoke(null, null)
+            }
+        }
+    }
+
+    private inner class Bridge {
+        @JavascriptInterface
+        fun recordPost(key: String, action: String, enctype: String, fields: String) {
+            if (key != secret) return
+            val page = pageUrl
+            val sameOrigin = origin(action) != null && origin(action) == origin(page)
+            val pairs = runCatching {
+                val arr = JSONArray(fields)
+                (0 until arr.length()).map {
+                    val p = arr.getJSONArray(it)
+                    p.getString(0) to p.getString(1)
+                }
+            }.getOrNull() ?: return
+            val (contentType, body) = encodeForm(enctype.lowercase(), pairs)
+            val post = RecordedPost(
+                action, page, contentType, body, sameOrigin, System.currentTimeMillis()
+            )
+            mainHandler.post { lastPost = post }
+        }
+
+        @JavascriptInterface
+        fun recordName(key: String, href: String, name: String) {
+            if (key != secret || name.isEmpty()) return
+            mainHandler.post {
+                names[href] = name to System.currentTimeMillis()
+                while (names.size > 16) {
+                    names.remove(names.keys.first())
+                }
+            }
+        }
+
+        @JavascriptInterface
+        fun blobData(key: String, token: String, dataUrl: String, type: String) {
+            if (key != secret) return
+            val bytes = if (dataUrl.isEmpty()) null else decodeDataUrl(dataUrl)?.first
+            mainHandler.post {
+                blobCallbacks.remove(token)?.invoke(bytes, type.ifEmpty { null })
+            }
+        }
+    }
+
+    private fun script() = """
+        (function () {
+          var K = '$secret', B = window.$BRIDGE_NAME;
+          if (!B || window.__jellyDl) return;
+          var blobs = {};
+          function keep(href) {
+            // Fetch a blob: URL right away: pages revoke it as soon as the click returns
+            if (href && href.indexOf('blob:') === 0 && !blobs[href]) {
+              blobs[href] = fetch(href).then(function (r) { return r.blob(); });
