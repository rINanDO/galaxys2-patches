+    /**
+     * Run a download that DownloadManager can't do on a background thread, and
+     * tell the user how it went. [work] returns the saved file and its type.
+     */
+    private fun saveDirect(fileName: String, work: () -> Pair<Uri, String?>?) {
+        Snackbar.make(
+            constraintLayout, getString(R.string.download_running, fileName),
+            Snackbar.LENGTH_SHORT
+        ).show()
+        uiScope.launch {
+            val result = withContext(Dispatchers.IO) {
+                runCatching(work).onFailure {
+                    Log.e(TAG, "Download of $fileName failed", it)
+                }.getOrNull()
+            }
+            if (result == null) {
+                Snackbar.make(
+                    constraintLayout, getString(R.string.download_failed, fileName),
+                    Snackbar.LENGTH_LONG
+                ).show()
+                return@launch
+            }
+            val (uri, type) = result
+            Snackbar.make(
+                constraintLayout, getString(R.string.download_done, fileName),
+                Snackbar.LENGTH_LONG
+            ).setAction(R.string.download_open) {
+                val intent = Intent(Intent.ACTION_VIEW)
+                    .setDataAndType(uri, type ?: contentResolver.getType(uri))
+                    .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                runCatching { startActivity(intent) }.onFailure {
+                    Log.w(TAG, "No app to open $fileName", it)
+                }
+            }.show()
+        }
+    }
