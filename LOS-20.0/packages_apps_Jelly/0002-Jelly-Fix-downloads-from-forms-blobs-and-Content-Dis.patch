     /**
-     * Parse the Content-Disposition HTTP Header. The format of the header
-     * is defined here: http://www.w3.org/Protocols/rfc2616/rfc2616-sec19.html
-     * This header provides a filename for content that is going to be
-     * downloaded to the file system. We only support the attachment type.
-     * Note that RFC 2616 specifies the filename value must be double-quoted.
-     * Unfortunately some servers do not quote the value so to maintain
-     * consistent behaviour with other browsers, we allow unquoted values too.
+     * Parse the Content-Disposition HTTP Header (RFC 6266) and return the
+     * file name it suggests. filename* (RFC 5987, e.g. UTF-8''%E2%82%AC.txt)
+     * wins over filename. Any disposition type is accepted, other parameters
+     * may follow the file name, and unquoted or percent-encoded names are
+     * accepted as other browsers do.
      */
-    private fun parseContentDisposition(contentDisposition: String) = runCatching {
-        val m = CONTENT_DISPOSITION_PATTERN.matcher(contentDisposition)
-        if (m.find()) {
-            return@runCatching m.group(2)
+    fun parseContentDisposition(contentDisposition: String): String? = runCatching {
+        var plain: String? = null
+        var extended: String? = null
+        for (param in splitHeaderParams(contentDisposition)) {
+            val eq = param.indexOf('=')
+            if (eq <= 0) continue
+            val value = param.substring(eq + 1).trim()
+            when (param.substring(0, eq).trim().lowercase(Locale.ROOT)) {
+                "filename*" -> extended = extended ?: decodeExtValue(unquote(value))
+                "filename" -> plain = plain ?: unquote(value).let { percentDecodeUtf8(it) ?: it }
+            }
         }
-
-        return@runCatching null
+        sanitizeFileName(extended) ?: sanitizeFileName(plain)
     }.getOrNull()
 
+    /** Split a header value on ';' outside quoted strings */
+    private fun splitHeaderParams(header: String): List<String> {
+        val parts = mutableListOf<String>()
+        val cur = StringBuilder()
+        var quoted = false
+        var i = 0
+        while (i < header.length) {
+            val c = header[i]
+            when {
+                quoted && c == '\\' && i + 1 < header.length -> {
+                    cur.append(c).append(header[i + 1])
+                    i++
+                }
+                c == '"' -> {
+                    quoted = !quoted
+                    cur.append(c)
+                }
+                c == ';' && !quoted -> {
+                    parts.add(cur.toString())
+                    cur.setLength(0)
+                }
+                else -> cur.append(c)
+            }
+            i++
+        }
+        parts.add(cur.toString())
+        return parts
+    }
+
+    private fun unquote(value: String): String {
+        if (value.length < 2 || !value.startsWith('"')) return value
+        val sb = StringBuilder()
+        var i = 1
+        while (i < value.length) {
+            val c = value[i]
+            if (c == '\\' && i + 1 < value.length) {
+                sb.append(value[i + 1])
+                i += 2
+                continue
+            }
+            if (c == '"') break
+            sb.append(c)
+            i++
+        }
+        return sb.toString()
+    }
+
+    /** RFC 5987 ext-value: charset'language'percent-encoded */
+    private fun decodeExtValue(value: String): String? {
+        val first = value.indexOf('\'')
+        val second = if (first >= 0) value.indexOf('\'', first + 1) else -1
+        if (second < 0) return null
+        val charset = runCatching {
+            java.nio.charset.Charset.forName(value.substring(0, first).trim())
+        }.getOrNull() ?: return null
+        return percentDecode(value.substring(second + 1), charset)
+    }
+
+    private fun percentDecode(value: String, charset: java.nio.charset.Charset): String? {
+        val out = java.io.ByteArrayOutputStream()
+        var i = 0
+        while (i < value.length) {
+            val c = value[i]
+            if (c == '%') {
+                if (i + 2 >= value.length) return null
+                val b = value.substring(i + 1, i + 3).toIntOrNull(16) ?: return null
+                out.write(b)
+                i += 3
+            } else {
+                out.write(c.toString().toByteArray(charset))
+                i++
+            }
+        }
+        return String(out.toByteArray(), charset)
+    }
+
+    /** Decode a plain filename that a server percent-encoded, if it is valid UTF-8 */
+    private fun percentDecodeUtf8(value: String): String? {
+        if (!value.contains(Regex("%[0-9A-Fa-f]{2}"))) return null
+        val decoder = Charsets.UTF_8.newDecoder()
+        return runCatching {
+            val bytes = percentDecode(value, Charsets.ISO_8859_1)
+                ?.toByteArray(Charsets.ISO_8859_1) ?: return null
+            decoder.decode(java.nio.ByteBuffer.wrap(bytes)).toString()
+        }.getOrNull()
+    }
+
+    /**
+     * Make a suggested name safe to use as a file name in Downloads: keep the
+     * last path segment and drop characters that FAT/sdcardfs or the shell
+     * would choke on. Returns null if nothing usable is left.
+     */
+    fun sanitizeFileName(name: String?): String? {
+        if (name == null) return null
+        var n = name.substring(maxOf(name.lastIndexOf('/'), name.lastIndexOf('\\')) + 1)
+        n = n.replace(Regex("[\\x00-\\x1f\\x7f\"*:<>?|]"), "_").trim().trim('.').trim()
+        if (n.length > 200) {
+            val dot = n.lastIndexOf('.')
+            n = if (dot > 0 && n.length - dot <= 16) {
+                n.substring(0, 200 - (n.length - dot)) + n.substring(dot)
+            } else {
+                n.substring(0, 200)
+            }
+        }
+        return n.ifEmpty { null }
+    }
+
