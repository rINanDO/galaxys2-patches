+        /** Decode a data: URL into its bytes and MIME type. */
+        fun decodeDataUrl(url: String): Pair<ByteArray, String?>? {
+            val comma = url.indexOf(',')
+            if (!url.startsWith("data:", ignoreCase = true) || comma < 0) return null
+            val meta = url.substring(5, comma).split(';')
+            val data = url.substring(comma + 1)
+            val bytes = runCatching {
+                if (meta.any { it.equals("base64", ignoreCase = true) }) {
+                    Base64.decode(URLDecoder.decode(data.replace("+", "%2B"), "UTF-8"),
